# Nagrek environment variables
# Copy to .env (or set them in Hostinger hPanel → Node.js → Environment variables)

# Port is normally injected by Hostinger. Defaults to 3000 locally.
PORT=3000

# Optional: bind address (default 0.0.0.0)
# HOST=0.0.0.0

# Optional: allow cross-origin Socket.io clients (comma separated).
# Leave empty for same-origin only (recommended).
# CLIENT_ORIGIN=https://nagrek.com,https://www.nagrek.com

# TURN server (required in production for strict NATs/mobile carriers).
# TURN_URL can be a comma separated list.
TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# Supabase (Auth, Profiles & Database)
# Public variables are safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only — NEVER expose this in the client bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paywall bypass — when Razorpay keys are unset, paywall is skipped automatically.
# Set to 1 to force-skip even if keys exist (useful for staging without billing).
# NAGREK_SKIP_PAYWALL=1
# NEXT_PUBLIC_NAGREK_SKIP_PAYWALL=1

# Razorpay (Phase 2 — Subscriptions, start in test mode). Leave blank to skip paywall.
# RAZORPAY_KEY_ID=rzp_test_yourkeyid
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Plan IDs (created in Razorpay Dashboard → Subscriptions → Plans)
# RAZORPAY_PLAN_MONTHLY=plan_xxxx
# RAZORPAY_PLAN_QUARTERLY=plan_yyyy
# RAZORPAY_PLAN_BIANNUAL=plan_zzzz

# Cron auth for /api/cron/cleanup-inactive (Bearer or ?secret=). Required in production.
# CRON_SECRET=generate-a-long-random-string
