# Copy to .env.local (dev) or set these in the Hostinger panel (prod).
# Phase 1 runs entirely on mock data: every variable below is optional for now.
# Never commit real values. NEXT_PUBLIC_* values are shipped to the browser.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 2) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: use only in server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Free preview -------------------------------------------------------------
# true: with no Razorpay keys, plans and avatar items activate free (recorded as ₹0).
# Adding Razorpay keys turns this off automatically.
NEXT_PUBLIC_FREE_PREVIEW=true

# --- Razorpay (Phase 3, INR) -------------------------------------------------
# Dashboard → Account & Settings → API Keys. Use test-mode keys (rzp_test_...) until launch.
# Without these, `npm run dev` uses a mock checkout; production refuses payments.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<your-domain>/api/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed. Pick any strong secret.
RAZORPAY_WEBHOOK_SECRET=

# --- WebRTC (Phase 5) --------------------------------------------------------
# Comma-separated STUN URLs. Defaults to Google's public STUN server if empty.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# TURN is required for users behind strict NATs. Prefer short-lived credentials minted server-side.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Email (Phase 2, magic links / notifications) ----------------------------
RESEND_API_KEY=
EMAIL_FROM="Nagrek <hello@nagrek.com>"
