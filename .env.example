# Nagrek environment variables
# Copy to .env (or set them in Hostinger hPanel → Node.js → Environment variables)

# Port is normally injected by Hostinger. Defaults to 3000 locally.
PORT=3000

# Optional: bind address (default 0.0.0.0)
# HOST=0.0.0.0

# Optional: allow cross-origin Socket.io clients (comma separated).
# Leave empty for same-origin only (recommended).
# CLIENT_ORIGIN=https://nagrek.com,https://www.nagrek.com

# Optional TURN server (needed for users behind strict/corporate NATs).
# TURN_URL can be a comma separated list.
# TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
